# ---- Compose -------------------------------------------------------------------------------
# Dev uses the override that publishes ports on 127.0.0.1. On a production host set
# COMPOSE_FILE=docker-compose.yml (no override) and COMPOSE_PROFILES=prod.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
COMPOSE_PROJECT_NAME=sekretari
TZ=Europe/Tirane

# ---- App (host dev: `pnpm dev`) ---------------------------------------------------------------
# Public base URL of the app (used for links, redirects, e2e base URL)
APP_URL=http://localhost:3100
DEFAULT_LOCALE=sq

# ---- Postgres ---------------------------------------------------------------------------------
# Superuser of the server; only used by the init script and operators.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
# Application database and its own user (cannot connect to the Keycloak database)
APP_DB_NAME=sekretari
APP_DB_USER=sekretari
APP_DB_PASSWORD=change-me-app
# Keycloak database and its own user
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=change-me-keycloak
# Used by `pnpm dev` on the host. Containers get their own value pointing at the `db` service.
DATABASE_URL=postgresql://sekretari:change-me-app@localhost:5432/sekretari
# Dev only: `prisma migrate dev` shadow database and the integration-test database. Created by the
# db init script when CREATE_DEV_DATABASES=true (dev override). Never point these at real data:
# the tests truncate every table.
SHADOW_DATABASE_URL=postgresql://sekretari:change-me-app@localhost:5432/sekretari_shadow
TEST_DATABASE_URL=postgresql://sekretari:change-me-app@localhost:5432/sekretari_test

# ---- Keycloak ---------------------------------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
# Browser-facing URL. Dev: http://localhost:8080. Prod: https://auth.<domain>
KC_HOSTNAME=http://localhost:8080

# ---- Auth (PLT-04) ----------------------------------------------------------------------------
# Browser-facing issuer of realm `logos` (must match KC_HOSTNAME + /realms/logos)
KEYCLOAK_ISSUER=http://localhost:8080/realms/logos
KEYCLOAK_CLIENT_ID=sekretari-web
KEYCLOAK_CLIENT_SECRET=change-me-web-client-secret
KEYCLOAK_ADMIN_CLIENT_ID=sekretari-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-admin-client-secret
# Keycloak's own SMTP settings (activation emails). Defaults: Mailpit in the dev stack.
KC_SMTP_HOST=mailpit
KC_SMTP_PORT=1025
KC_SMTP_FROM=no-reply@logos.local
# Authenticated relay (production, e.g. Amazon SES): KC_SMTP_AUTH=true KC_SMTP_STARTTLS=true plus user/password.
KC_SMTP_AUTH=false
KC_SMTP_STARTTLS=false
KC_SMTP_USER=
KC_SMTP_PASSWORD=
# Alternative app URL allowed by the Keycloak client: the containerized app (`pnpm stack:up`).
# In production leave unset (falls back to APP_URL).
APP_URL_ALT=http://localhost:3000
# Random 32+ bytes: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# ---- Background jobs (PLT-12) -------------------------------------------------------------------
# embedded = this process also runs the job worker (default); off = it only enqueues jobs
JOBS_WORKER=embedded

# ---- Gotenberg / mail (dev: Mailpit) ----------------------------------------------------------
GOTENBERG_URL=http://localhost:3001
# Mail (PLT-11, Q-20). Development: Mailpit. Production: graph (Microsoft 365) with an app
# registration that has Mail.Send for MAIL_FROM, or an SMTP relay with OAuth/app password.
MAIL_TRANSPORT=smtp
MAIL_FROM=no-reply@logos.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=

# ---- Files ------------------------------------------------------------------------------------
# Host dev path; containers use /data/files (volume `files`).
FILES_DIR=./.data/files

# ---- Host ports (127.0.0.1 only, dev override). Change if a port is taken on your machine. ----
DB_PORT=5432
KEYCLOAK_PORT=8080
GOTENBERG_PORT=3001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# Port of the containerized app (`full` profile)
APP_PORT=3000

# ---- Production only (proxy profile) ----------------------------------------------------------
# Caddy requests TLS certificates for app.<DOMAIN> and auth.<DOMAIN>.
DOMAIN=example.org
ACME_EMAIL=admin@example.org
