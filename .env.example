# ---- Compose -------------------------------------------------------------------------------
# Dev uses the override that publishes ports on 127.0.0.1. On a production host set
# COMPOSE_FILE=docker-compose.yml (no override) and COMPOSE_PROFILES=prod.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
COMPOSE_PROJECT_NAME=sekretari
TZ=Europe/Tirane

# ---- App (host dev: `pnpm dev`) ---------------------------------------------------------------
# Public base URL of the app (used for links, redirects, e2e base URL)
APP_URL=http://localhost:3100
DEFAULT_LOCALE=sq

# ---- Postgres ---------------------------------------------------------------------------------
# Superuser of the server; only used by the init script and operators.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
# Application database and its own user (cannot connect to the Keycloak database)
APP_DB_NAME=sekretari
APP_DB_USER=sekretari
APP_DB_PASSWORD=change-me-app
# Keycloak database and its own user
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=change-me-keycloak
# Used by `pnpm dev` on the host. Containers get their own value pointing at the `db` service.
DATABASE_URL=postgresql://sekretari:change-me-app@localhost:5432/sekretari

# ---- Keycloak ---------------------------------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
# Browser-facing URL. Dev: http://localhost:8080. Prod: https://auth.<domain>
KC_HOSTNAME=http://localhost:8080

# ---- Gotenberg / mail (dev: Mailpit) ----------------------------------------------------------
GOTENBERG_URL=http://localhost:3001
SMTP_HOST=localhost
SMTP_PORT=1025

# ---- Files ------------------------------------------------------------------------------------
# Host dev path; containers use /data/files (volume `files`).
FILES_DIR=./.data/files

# ---- Host ports (127.0.0.1 only, dev override). Change if a port is taken on your machine. ----
DB_PORT=5432
KEYCLOAK_PORT=8080
GOTENBERG_PORT=3001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# Port of the containerized app (`full` profile)
APP_PORT=3000

# ---- Production only (proxy profile) ----------------------------------------------------------
# Caddy requests TLS certificates for app.<DOMAIN> and auth.<DOMAIN>.
DOMAIN=example.org
ACME_EMAIL=admin@example.org
