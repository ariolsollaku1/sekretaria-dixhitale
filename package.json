{
  "name": "sekretari-dixhitale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "infra:up": "docker compose --profile dev up -d --wait && node scripts/keycloak-dev-users.mjs",
    "infra:down": "docker compose --profile dev --profile full --profile prod down",
    "infra:logs": "docker compose --profile dev logs -f",
    "infra:reset": "node scripts/infra-reset.mjs",
    "stack:up": "docker compose --profile dev --profile full up -d --build --wait",
    "infra:smoke": "bash scripts/infra-smoke.sh",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file-if-exists=.env node_modules/prisma/build/index.js db seed",
    "db:reset": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate reset",
    "db:studio": "node --env-file-if-exists=.env node_modules/prisma/build/index.js studio",
    "test:coverage": "vitest run --project unit --coverage",
    "i18n:check": "node scripts/i18n-check.mjs",
    "iam:bootstrap-admin": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs --conditions=react-server scripts/iam-bootstrap-admin.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.61.0",
    "next": "^16.3.8",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "read-excel-file": "^9.3.12",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "exceljs": "^4.4.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
