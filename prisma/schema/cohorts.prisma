/// An intake of a program in one academic year; follows one approved curriculum plan (ORG-04).
model Cohort {
  id                  String         @id @default(cuid(2))
  programId           String         @map("program_id")
  startAcademicYearId String         @map("start_academic_year_id")
  curriculumPlanId    String         @map("curriculum_plan_id")
  name                String
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById         String?        @map("created_by_id")
  updatedById         String?        @map("updated_by_id")
  program             StudyProgram   @relation(fields: [programId], references: [id])
  startYear           AcademicYear   @relation(fields: [startAcademicYearId], references: [id])
  plan                CurriculumPlan @relation(fields: [curriculumPlanId], references: [id])
  groups              StudentGroup[]

  @@unique([programId, startAcademicYearId, name])
  @@index([curriculumPlanId])
  @@map("cohorts")
}

/// A teaching group of a cohort for one academic year and year of study (ORG-04).
model StudentGroup {
  id             String       @id @default(cuid(2))
  cohortId       String       @map("cohort_id")
  academicYearId String       @map("academic_year_id")
  yearOfStudy    Int          @map("year_of_study")
  name           String
  /// Informational until STU-01 defines enrollment limits.
  capacity       Int?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?      @map("created_by_id")
  updatedById    String?      @map("updated_by_id")
  cohort         Cohort       @relation(fields: [cohortId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([cohortId, academicYearId, yearOfStudy, name])
  @@index([academicYearId])
  @@map("student_groups")
}
