enum FeeKind {
  TUITION
  ADMINISTRATIVE
  DIPLOMA
  BACKLOG_EXAM
  OTHER

  @@map("fee_kind")
}

enum DiscountKind {
  PERCENT
  AMOUNT

  @@map("discount_kind")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER

  @@map("payment_method")
}

enum PaymentStatus {
  RECORDED
  VOIDED

  @@map("payment_status")
}

enum InstallmentStatus {
  ACTIVE
  CANCELLED

  @@map("installment_status")
}

/// A fee of a program for an academic year (FIN-01, Q-85). Never deleted, only deactivated.
model FeeScheduleItem {
  id             String                   @id @default(cuid(2))
  programId      String                   @map("program_id")
  academicYearId String                   @map("academic_year_id")
  kind           FeeKind
  /// Tells apart several fees of one kind; empty when there is one.
  label          String                   @default("")
  amount         Decimal                  @db.Decimal(12, 2)
  active         Boolean                  @default(true)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?                  @map("created_by_id")
  updatedById    String?                  @map("updated_by_id")
  program        StudyProgram             @relation(fields: [programId], references: [id])
  academicYear   AcademicYear             @relation(fields: [academicYearId], references: [id])
  installments   FeeInstallmentTemplate[]
  discounts      FeeDiscount[]

  @@unique([programId, academicYearId, kind, label])
  @@index([academicYearId])
  @@map("fee_schedule_items")
}

/// One installment of a fee (Q-86); they add up to the fee.
model FeeInstallmentTemplate {
  id       String          @id @default(cuid(2))
  itemId   String          @map("item_id")
  sequence Int
  dueDate  DateTime        @map("due_date") @db.Date
  amount   Decimal         @db.Decimal(12, 2)
  item     FeeScheduleItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, sequence])
  @@map("fee_installment_templates")
}

/// An early-payment or preferential discount with a date window (Q-87).
model FeeDiscount {
  id        String          @id @default(cuid(2))
  itemId    String          @map("item_id")
  label     String          @default("")
  kind      DiscountKind
  /// A percentage (0-100) or an amount, by kind.
  value     Decimal         @db.Decimal(12, 2)
  validFrom DateTime        @map("valid_from") @db.Date
  validTo   DateTime        @map("valid_to") @db.Date
  item      FeeScheduleItem @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@map("fee_discounts")
}

/// A student's payment plan for one academic year of an enrollment (FIN-01, Q-88).
model PaymentPlan {
  id             String            @id @default(cuid(2))
  enrollmentId   String            @map("enrollment_id")
  academicYearId String            @map("academic_year_id")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?           @map("created_by_id")
  updatedById    String?           @map("updated_by_id")
  enrollment     Enrollment        @relation(fields: [enrollmentId], references: [id])
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id])
  installments   PlanInstallment[]
  payments       Payment[]

  @@unique([enrollmentId, academicYearId])
  @@index([academicYearId])
  @@map("payment_plans")
}

/// An installment of a plan; adjusted or cancelled with a reason, never deleted (Q-89).
model PlanInstallment {
  id             String            @id @default(cuid(2))
  planId         String            @map("plan_id")
  sequence       Int
  kind           FeeKind
  label          String            @default("")
  dueDate        DateTime          @map("due_date") @db.Date
  amount         Decimal           @db.Decimal(12, 2)
  /// The amount if paid by `earlyUntil` under the best discount (Q-87).
  earlyAmount    Decimal?          @map("early_amount") @db.Decimal(12, 2)
  earlyUntil     DateTime?         @map("early_until") @db.Date
  status         InstallmentStatus @default(ACTIVE)
  /// The fee it came from; null for an installment added by hand.
  scheduleItemId String?           @map("schedule_item_id")
  adjustedAt     DateTime?         @map("adjusted_at") @db.Timestamptz(3)
  cancelReason   String?           @map("cancel_reason")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?           @map("created_by_id")
  updatedById    String?           @map("updated_by_id")
  plan           PaymentPlan       @relation(fields: [planId], references: [id])
  payments       Payment[]

  @@unique([planId, sequence])
  @@index([dueDate])
  @@map("plan_installments")
}

/// A payment received on a payment plan (FIN-02, Q-109). Never deleted, only voided with a reason.
/// How it is spread over the installments is computed (domain/payment-rules), not stored.
model Payment {
  id            String           @id @default(cuid(2))
  planId        String           @map("plan_id")
  amount        Decimal          @db.Decimal(12, 2)
  paidOn        DateTime         @map("paid_on") @db.Date
  reference     String           @default("")
  method        PaymentMethod
  /// The installment the payer meant to pay; it is paid first.
  installmentId String?          @map("installment_id")
  status        PaymentStatus    @default(RECORDED)
  voidReason    String?          @map("void_reason")
  voidedAt      DateTime?        @map("voided_at") @db.Timestamptz(3)
  voidedById    String?          @map("voided_by_id")
  /// Groups the rows of one file import (Q-112).
  importBatch   String?          @map("import_batch")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById   String?          @map("created_by_id")
  updatedById   String?          @map("updated_by_id")
  plan          PaymentPlan      @relation(fields: [planId], references: [id])
  installment   PlanInstallment? @relation(fields: [installmentId], references: [id])

  @@index([planId])
  @@index([paidOn])
  @@map("payments")
}
