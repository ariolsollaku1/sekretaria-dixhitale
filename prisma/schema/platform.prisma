/// Runtime-configurable settings (key -> JSON value). Validated with Zod in src/lib/db/settings.ts.
model SystemSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id")

  @@map("system_settings")
}

/// Fixed role list (roles.md); hyphenated keys there are underscored here.
enum Role {
  sysadmin
  secretary
  student_affairs
  lecturer
  finance
  hr
  quality
  library
  administration
  student
  head_of_department
  program_coordinator
  erasmus

  @@map("role")
}

/// What a role assignment covers. INSTITUTION ⊃ FACULTY ⊃ DEPARTMENT ⊃ PROGRAM; SELF = own records.
enum ScopeType {
  INSTITUTION
  FACULTY
  DEPARTMENT
  PROGRAM
  SELF

  @@map("scope_type")
}

/// A user can hold several assignments, each with its own scope and validity window.
model UserRole {
  id          String    @id @default(cuid(2))
  userId      String    @map("user_id")
  role        Role
  scopeType   ScopeType @map("scope_type")
  /// Faculty/department/program id; null for INSTITUTION and SELF.
  scopeId     String?   @map("scope_id")
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo     DateTime? @map("valid_to") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NULLS NOT DISTINCT (added in the migration) so INSTITUTION/SELF rows cannot be duplicated.
  @@unique([userId, role, scopeType, scopeId])
  @@index([userId])
  @@map("user_roles")
}

enum AuditActorType {
  USER
  SYSTEM
  PUBLIC

  @@map("audit_actor_type")
}

/// Append-only trace of business mutations and auth events. UPDATE/DELETE are rejected by a
/// trigger (see the migration). No foreign key to users: the trace must outlive any user row.
model AuditLog {
  id          String         @id @default(cuid(2))
  at          DateTime       @default(now()) @db.Timestamptz(3)
  actorType   AuditActorType @map("actor_type")
  actorUserId String?        @map("actor_user_id")
  /// `<module>.<resource>.<verb>`, e.g. `stu.student.update`
  action      String
  entityType  String         @map("entity_type")
  entityId    String?        @map("entity_id")
  /// Only the changed fields; sensitive values are masked.
  before      Json?
  after       Json?
  reason      String?
  requestId   String?        @map("request_id")
  ip          String?
  userAgent   String?        @map("user_agent")

  @@index([entityType, entityId, at])
  @@index([actorUserId, at])
  @@index([at])
  @@map("audit_logs")
}

enum FileStatus {
  PENDING
  ATTACHED

  @@map("file_status")
}

/// Metadata of an uploaded or generated file; the bytes live in the Storage (PLT-08, ADR-0010).
model StoredFile {
  id           String     @id @default(cuid(2))
  /// Opaque key `yyyy/mm/<id>`; never derived from user input.
  storageKey   String     @unique @map("storage_key")
  purpose      String
  /// Sanitized original name, for display and the download header only.
  fileName     String     @map("file_name")
  mimeType     String     @map("mime_type")
  size         Int
  sha256       String
  status       FileStatus @default(PENDING)
  entityType   String?    @map("entity_type")
  entityId     String?    @map("entity_id")
  uploadedById String     @map("uploaded_by_id")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  attachedAt   DateTime?  @map("attached_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)
  deletedById  String?    @map("deleted_by_id")

  @@index([entityType, entityId])
  @@index([status, createdAt])
  @@map("stored_files")
}

/// A user's named filter on a table (PLT-10): the URL query of the filters, without paging.
model SavedFilter {
  id        String   @id @default(cuid(2))
  userId    String   @map("user_id")
  tableId   String   @map("table_id")
  name      String
  query     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tableId, name])
  @@index([userId, tableId])
  @@map("saved_filters")
}

enum BackupRunKind {
  EXPORT
  INTEGRITY

  @@map("backup_run_kind")
}

enum BackupRunStatus {
  RUNNING
  SUCCEEDED
  FAILED

  @@map("backup_run_status")
}

/// One run of the full export or the integrity check (PLT-13). Never deleted by code; an export's
/// ZIP lives at `<FILES_DIR>/exports/<fileName>` until retention purges it (`purgedAt`).
model BackupRun {
  id            String          @id @default(cuid(2))
  kind          BackupRunKind
  status        BackupRunStatus @default(RUNNING)
  /// Null = scheduled by the job system.
  requestedById String?         @map("requested_by_id")
  startedAt     DateTime        @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?       @map("finished_at") @db.Timestamptz(3)
  tableCount    Int             @default(0) @map("table_count")
  rowCount      Int             @default(0) @map("row_count")
  fileCount     Int             @default(0) @map("file_count")
  /// Integrity check: files / exports that are missing or do not match; export: files left out.
  problemCount  Int             @default(0) @map("problem_count")
  sizeBytes     BigInt?         @map("size_bytes")
  sha256        String?
  fileName      String?         @map("file_name")
  purgedAt      DateTime?       @map("purged_at") @db.Timestamptz(3)
  /// Short code only (never an error message: it could contain personal data).
  errorCode     String?         @map("error_code")

  @@index([kind, startedAt])
  @@map("backup_runs")
}
