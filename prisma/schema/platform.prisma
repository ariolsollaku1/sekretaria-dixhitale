/// Runtime-configurable settings (key -> JSON value). Validated with Zod in src/lib/db/settings.ts.
model SystemSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id")

  @@map("system_settings")
}

/// Fixed role list (roles.md); hyphenated keys there are underscored here.
enum Role {
  sysadmin
  secretary
  student_affairs
  lecturer
  finance
  hr
  quality
  library
  administration
  student
  head_of_department
  program_coordinator
  erasmus

  @@map("role")
}

/// What a role assignment covers. INSTITUTION ⊃ FACULTY ⊃ DEPARTMENT ⊃ PROGRAM; SELF = own records.
enum ScopeType {
  INSTITUTION
  FACULTY
  DEPARTMENT
  PROGRAM
  SELF

  @@map("scope_type")
}

/// A user can hold several assignments, each with its own scope and validity window.
model UserRole {
  id          String    @id @default(cuid(2))
  userId      String    @map("user_id")
  role        Role
  scopeType   ScopeType @map("scope_type")
  /// Faculty/department/program id; null for INSTITUTION and SELF.
  scopeId     String?   @map("scope_id")
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo     DateTime? @map("valid_to") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NULLS NOT DISTINCT (added in the migration) so INSTITUTION/SELF rows cannot be duplicated.
  @@unique([userId, role, scopeType, scopeId])
  @@index([userId])
  @@map("user_roles")
}

enum AuditActorType {
  USER
  SYSTEM
  PUBLIC

  @@map("audit_actor_type")
}

/// Append-only trace of business mutations and auth events. UPDATE/DELETE are rejected by a
/// trigger (see the migration). No foreign key to users: the trace must outlive any user row.
model AuditLog {
  id          String         @id @default(cuid(2))
  at          DateTime       @default(now()) @db.Timestamptz(3)
  actorType   AuditActorType @map("actor_type")
  actorUserId String?        @map("actor_user_id")
  /// `<module>.<resource>.<verb>`, e.g. `stu.student.update`
  action      String
  entityType  String         @map("entity_type")
  entityId    String?        @map("entity_id")
  /// Only the changed fields; sensitive values are masked.
  before      Json?
  after       Json?
  reason      String?
  requestId   String?        @map("request_id")
  ip          String?
  userAgent   String?        @map("user_agent")

  @@index([entityType, entityId, at])
  @@index([actorUserId, at])
  @@index([at])
  @@map("audit_logs")
}

enum FileStatus {
  PENDING
  ATTACHED

  @@map("file_status")
}

/// Metadata of an uploaded or generated file; the bytes live in the Storage (PLT-08, ADR-0010).
model StoredFile {
  id           String     @id @default(cuid(2))
  /// Opaque key `yyyy/mm/<id>`; never derived from user input.
  storageKey   String     @unique @map("storage_key")
  purpose      String
  /// Sanitized original name, for display and the download header only.
  fileName     String     @map("file_name")
  mimeType     String     @map("mime_type")
  size         Int
  sha256       String
  status       FileStatus @default(PENDING)
  entityType   String?    @map("entity_type")
  entityId     String?    @map("entity_id")
  uploadedById String     @map("uploaded_by_id")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  attachedAt   DateTime?  @map("attached_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)
  deletedById  String?    @map("deleted_by_id")

  @@index([entityType, entityId])
  @@index([status, createdAt])
  @@map("stored_files")
}
