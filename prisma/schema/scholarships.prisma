enum ScholarshipType {
  FULL
  PARTIAL

  @@map("scholarship_type")
}

enum ScholarshipCategory {
  EXCELLENCE
  NEED
  DISABILITY
  OTHER

  @@map("scholarship_category")
}

/// A full or partial scholarship of an enrollment for one academic year (FIN-03, Q-23). It reduces
/// the tuition installments of the year's plan; voiding it gives the reduction back. Never deleted.
model Scholarship {
  id             String              @id @default(cuid(2))
  enrollmentId   String              @map("enrollment_id")
  academicYearId String              @map("academic_year_id")
  type           ScholarshipType
  category       ScholarshipCategory
  /// PARTIAL by percentage: 0 < percent < 100. Exactly one of percent / amount for PARTIAL, none for FULL.
  percent        Decimal?            @db.Decimal(5, 2)
  /// PARTIAL by a fixed amount, taken from the tuition of the year.
  amount         Decimal?            @db.Decimal(12, 2)
  reason         String
  /// The application this decision answers; null when Finance grants it directly.
  submissionId   String?             @map("submission_id")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById    String?             @map("created_by_id")
  voidedAt       DateTime?           @map("voided_at") @db.Timestamptz(3)
  voidedById     String?             @map("voided_by_id")
  voidReason     String?             @map("void_reason")
  enrollment     Enrollment          @relation(fields: [enrollmentId], references: [id])
  academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id])
  submission     FormSubmission?     @relation(fields: [submissionId], references: [id])
  cuts           ScholarshipCut[]

  @@index([academicYearId, voidedAt])
  @@index([enrollmentId])
  @@index([submissionId])
  @@map("scholarships")
}

/// How much a scholarship took off one plan installment (and whether it cancelled it), so that
/// voiding gives exactly that back.
model ScholarshipCut {
  id            String          @id @default(cuid(2))
  scholarshipId String          @map("scholarship_id")
  installmentId String          @map("installment_id")
  amount        Decimal         @db.Decimal(12, 2)
  /// The installment reached zero and was cancelled by this cut.
  cancelled     Boolean         @default(false)
  scholarship   Scholarship     @relation(fields: [scholarshipId], references: [id])
  installment   PlanInstallment @relation(fields: [installmentId], references: [id])

  @@unique([scholarshipId, installmentId])
  @@index([installmentId])
  @@map("scholarship_cuts")
}
